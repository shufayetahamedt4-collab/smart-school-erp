rules_version = '2';

// The app talks to Firestore exclusively through the Firebase Admin SDK
// (server-side Next.js API routes), which bypasses these rules.
// Therefore, direct client access is denied entirely.
// PRD v1.2 adds many collections (admissions, ledger, notifications, …) —
// all are written server-side, so the deny-all posture is unchanged.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
