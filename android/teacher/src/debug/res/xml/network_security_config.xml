<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY network config (overrides res/xml/network_security_config.xml
     in debug builds). Local development talks to a plain-HTTP dev server, which
     the release build correctly forbids. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
