# ---- Firebase (required) -----------------------------------------------
# Create a project at https://console.firebase.google.com, enable Firestore +
# Storage, then download a service-account key (Project settings → Service
# accounts → Generate new private key). Use either option A or option B.

# Option A: three env vars (project_id / client_email / private_key from JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes intact, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Storage bucket name. Newer projects use <projectId>.firebasestorage.app;
# older ones use <projectId>.appspot.com. Wrong value = every photo 404s.
FIREBASE_STORAGE_BUCKET=

# Option B: point at the downloaded service-account JSON instead
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- App (required) ----------------------------------------------------
# Long random string shared by all instances (signs JWT sessions)
JWT_SECRET=change-me-to-a-long-random-string
# Public origin — used for QR links and storage download URLs
APP_URL=http://localhost:3000

# ---- Sector apps (one platform, separate apps) --------------------------
# Each role signs in to its own app on its own subdomain:
#   admin.<APP_DOMAIN>    Super Admin console
#   school.<APP_DOMAIN>   School Admin console (+ accountant/librarian/front desk)
#   teacher.<APP_DOMAIN>  Teacher app
#   parents.<APP_DOMAIN>  Guardian / parents app
#
# There is no student app: students do not carry phones in class, so the
# family-facing facilities live in the Parents App, which the child uses on the
# guardian's device.
#
# Set APP_DOMAIN to the registrable domain (no scheme, no subdomain). Leave it
# unset in local development: <app>.localhost already resolves to 127.0.0.1,
# and the bare host stays a permissive hub so harnesses keep working.
# APP_DOMAIN=yourdomain.com

# ---- Android apps (optional — native shells for two of the sector apps) --
# There are two native apps, built from one Gradle project (android/) that share
# one WebView shell: the Parents App and the Teacher App. Each has its own
# package, its own Play listing and its own origin.
#
# Digital Asset Links. Android fetches /.well-known/assetlinks.json to decide
# whether links to a host open the app instead of a browser (App Links). Without
# a fingerprint, a printed link or QR always opens the browser — the correct
# fallback, but not the app.
#
# One package/certificate pair per app:
#   ANDROID_APP_PACKAGE         com.amareeschool.parents    (Parents App)
#   ANDROID_TEACHER_APP_PACKAGE com.amareeschool.teachers   (Teacher App)
#
# ANDROID_APP_PACKAGE=com.amareeschool.parents
# ANDROID_TEACHER_APP_PACKAGE=com.amareeschool.teachers
# ANDROID_CERT_SHA256=            # Parents App fingerprint(s), comma separated
# ANDROID_TEACHER_CERT_SHA256=    # Teacher App fingerprint(s), comma separated
#                                 #   keytool -list -v -keystore <ks> -alias <alias>
#                                 # use the PLAY APP SIGNING SHA-256 once published,
#                                 # not the upload key. The local debug key is:
#                                 #   69:B5:00:16:36:2A:00:7D:FF:E3:36:3B:9B:15:7F:03:4E:93:C4:54:55:0E:CC:30:41:3E:5B:00:55:F6:00:B5
#
# Google Play listing URL — shown on a school's entry page as
# "Get it from Google Play" for Android visitors.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.amareeschool.parents

# ---- Transactional email (optional) ------------------------------------
# Used for password-reset OTP delivery. Without EMAIL_API_KEY the app falls
# back to a dev-console adapter that only logs the message OUTSIDE production
# (in production it refuses to print codes and reports a misconfiguration).
#
# EMAIL_API_KEY is a provider API key (Resend, or a SendGrid/Mailgun/Postmark
# gateway when EMAIL_API_URL is pointed at it). RESEND_API_KEY also works.
# EMAIL_PROVIDER=resend            # resend | http | console (default: auto)
# EMAIL_API_KEY=
# EMAIL_FROM="Amar E School <no-reply@example.com>"
# EMAIL_API_URL=https://api.resend.com/emails

# ---- Optional ----------------------------------------------------------
# PORT=3000
# ---- Read cache (optional) ---------------------------------------------
# Every Firestore round trip costs ~0.5s (and ~3.6s for the first one after a
# cold start) from a network far from the database, so reads are memoized per
# server process:
#   DB_READ_CACHE_MS  how long a result counts as fresh        (default 30000)
#   DB_READ_GRACE_MS  how long an expired result may still be served while it
#                     refreshes in the background — this is what stops a click
#                     from waiting on the network         (default 120000, 0 off)
# Any write through the app clears the cache, so your own submits are never
# stale; only out-of-band changes (seed script, Firestore console, another
# instance) can be invisible for up to the grace window.
# DB_READ_CACHE_MS=30000
# DB_READ_GRACE_MS=120000
