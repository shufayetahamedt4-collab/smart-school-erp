# ---- Firebase (required) -----------------------------------------------
# Create a project at https://console.firebase.google.com, enable Firestore +
# Storage, then download a service-account key (Project settings → Service
# accounts → Generate new private key). Use either option A or option B.

# Option A: three env vars (project_id / client_email / private_key from JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes intact, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Option B: point at the downloaded service-account JSON instead
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- App (required) ----------------------------------------------------
# Long random string shared by all instances (signs JWT sessions)
JWT_SECRET=change-me-to-a-long-random-string
# Public origin — used for QR links and storage download URLs
APP_URL=http://localhost:3000

# ---- Optional ----------------------------------------------------------
# PORT=3000
