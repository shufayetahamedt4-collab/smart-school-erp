{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "node_modules/**",
      ".next/**",
      ".git/**",
      ".freebuff/**",
      "dev-server*.log",
      "service-account.json",
      "*.tsbuildinfo"
    ],
    "frameworksBackend": {
      "region": "asia-southeast1"
    }
  }
}
